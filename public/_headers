# Nagłówki bezpieczeństwa (Cloudflare Pages / Netlify).
# Ścisła CSP (tylko 'self' + sumy SHA-256 skryptu i stylu z index.html) + frame-ancestors 'none'.
# Linię Content-Security-Policy aktualizuje automatycznie: npm run build (nie edytuj ręcznie).
# connect-src 'self' – jedyne połączenie to /api/verify (weryfikacja płatności na tej samej domenie).
# Przejście do płatności Stripe to zwykła nawigacja (nie wymaga zmian w CSP).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-ZG0WMGwOF/zz+cXpDJqAUSF9vbskUpPVllRbqta4DrM='; style-src 'sha256-0ASWoKPOVmHYj2ExpDEWRzeEQuR86hrRbzePu7ENtkY='; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; upgrade-insecure-requests; trusted-types kzp; require-trusted-types-for 'script'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

# Adresy *.pages.dev nie powinny trafiać do Google (duplikat domeny głównej).
https://:project.pages.dev/*
  X-Robots-Tag: noindex
